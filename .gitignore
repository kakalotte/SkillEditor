# Rust build output
/target/

# Packaged application bundles
/dist/

# Generated by tauri-build (ACL schemas, regenerated on every build).
# Upstream Tauri templates ignore this directory too.
/src-tauri/gen/schemas/

# Test / coverage output
*.profraw
lcov.info

# CI-generated Windows signing overlay (contains a runner-specific thumbprint)
/src-tauri/tauri.windows.conf.json

# Local signing material must never be committed
*.p12
*.pfx
*.cer
*.mobileprovision

# Editors
.idea/
.vs/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# Python bytecode (packaging/make-icons.py)
__pycache__/
*.pyc
